# Copy this file to .env and adjust values for your local environment.
# Never commit your real .env file.

# A long, random, secret string used for cryptographic signing.
SECRET_KEY=change-this-to-a-long-random-secret-key

# Set to False in any environment that is reachable by anyone other than you.
DEBUG=True

# Comma-separated list of hostnames the app is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of maximum resume upload size, in megabytes.
RESUME_MAX_UPLOAD_MB=5
